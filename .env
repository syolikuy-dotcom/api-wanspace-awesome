# ───────── Umum ─────────
NEXT_PUBLIC_SITE_URL=https://api-wanspace-awesome.vercel.app

# ───────── Anti-abuse (sangat disarankan di production) ─────────
# Tanpa Redis, rate limit hanya per-instance serverless (cukup untuk dev, lemah di production).
# Buat database gratis di Upstash (atau Vercel Marketplace → Upstash Redis), lalu isi:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# (alternatif nama dari Vercel KV: KV_REST_API_URL / KV_REST_API_TOKEN)

# Garam untuk meng-hash IP sebelum disimpan (isi string acak panjang, jangan di-commit)
IP_HASH_SALT=ganti-dengan-string-acak-panjang

# Batas permintaan per IP (poin; endpoint berat memakai cost > 1)
RATE_LIMIT_PER_MIN=60
RATE_LIMIT_BURST_10S=15
# Auto-block: kena limit sebanyak N kali dalam 10 menit → diblok sekian detik
AUTO_BLOCK_STRIKES=5
AUTO_BLOCK_SECONDS=900

# Blokir manual (pisahkan koma)
BLOCKED_IPS=

# CORS: kosong = semua origin boleh (API publik). Isi daftar origin (pisah koma) untuk membatasi.
CORS_ORIGINS=
